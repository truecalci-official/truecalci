{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truecalci",
  "compatibility_date": "2024-09-01",
  "pages_build_output_dir": "./public_deploy",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
