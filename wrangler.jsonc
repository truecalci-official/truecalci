{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truecalci",
  "main": "public_deploy/_worker.js",
  "compatibility_date": "2024-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public_deploy",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "truecalci.com",
      "custom_domain": true
    }
  ]
}